{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fossight",
  "version": "1.0.0",
  "identifier": "com.intelligenceworks.ossupdatewatch",
  "build": {
    "frontendDist": "../src/oss_update_watch/ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/fossight-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
